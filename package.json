{
  "name": "llm-router",
  "version": "0.1.0",
  "description": "TS implementation of a multi-provider agentic loop",
  "main": "dist/index.js",
  "bin": {
    "llm-router": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "keywords": [
    "llm",
    "router",
    "agentic",
    "cli"
  ],
  "author": "Anas Lecaillon",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@google/genai": "^1.24.0",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "commander": "^12.0.0",
    "openai": "^6.3.0"
  }
}
